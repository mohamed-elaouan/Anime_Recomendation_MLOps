pipeline {
    agent any
    stages {
        stage('Cloning from Github ... ') {
            steps {
                script{
                    echo "Cloning from Github"
                    checkout scmGit(branches: [[name: '*/master']], extensions: [], userRemoteConfigs: [[credentialsId: 'github-token', url: 'https://github.com/mohamed-elaouan/Anime_Recomendation_MLOps.git']])
                }
            }
        }
    }
}